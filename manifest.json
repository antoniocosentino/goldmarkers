{
  "manifest_version": 3,
  "name": "Gmail Gold Markers",
  "version": "0.1.0",
  "description": "Restore gold importance markers in Gmail.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/important-yellow.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
